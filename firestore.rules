rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    match /articles/{id} {
      allow read: if true;
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 12000
                    && request.resource.data.image.size() <= 400000
                    && (isAdmin() ||
                        (request.resource.data.admin == false && request.resource.data.type == "misc"));
      allow update: if isAdmin();
      // Admins can delete anything; anyone can delete issues older than 7 days (auto-cleanup)
      allow delete: if isAdmin() ||
                    resource.data.ts < request.time.toMillis() - 604800000;
    }

    // The writer code lives HERE, not in the website's code.
    match /admins/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.code == "dngjournal";
    }
  }
}
